# Postgres connection string used by apps/api, apps/worker, and packages/db migrations
# Local Docker Postgres (default): postgres://sec1cng:sec1cng@localhost:5432/sec1cng
# Using Supabase instead? See docs/github-actions.md's "Using Supabase specifically" section —
# use the session pooler (port 5432, not the IPv6-only direct host) with
# ?uselibpqcompat=true&sslmode=require.
DATABASE_URL=postgres://sec1cng:sec1cng@localhost:5432/sec1cng

# Redis connection string used by BullMQ (apps/worker) for queues/schedulers
REDIS_URL=redis://localhost:6379

# NVD API key (free, https://nvd.nist.gov/developers/request-an-api-key)
# Without a key: 5 requests/30s. With a key: 50 requests/30s.
# Leave blank to run unauthenticated (slower) ingestion.
NVD_API_KEY=

# GitHub personal access token (read-only scopes are sufficient) used for the
# GitHub Security Advisory GraphQL API. Without this, GHSA ingestion is
# fully wired but no-ops (logs "skipped: no GITHUB_TOKEN configured").
GITHUB_TOKEN=

# Port the Fastify API server listens on
PORT=4000

# Ransomware.live Pro API key (https://api-pro.ransomware.live/docs), used by
# the Ransomware Group Tracker feature. Auth via X-Api-Key header. Without
# this, ransomware sync cleanly no-ops (logs "skipped: no
# RANSOMWARE_LIVE_API_KEY configured").
RANSOMWARE_LIVE_API_KEY=

# AbuseIPDB API key (free tier, https://www.abuseipdb.com/account/api), used
# by the Threat Intel / IOC Lookup feature for IP reputation checks. Without
# this, that source is simply omitted from lookup results.
ABUSEIPDB_API_KEY=

# VirusTotal API key (free tier, https://www.virustotal.com/gui/my-apikey),
# used by the Threat Intel / IOC Lookup feature for hash/IP/domain/URL
# reputation checks. Without this, that source is simply omitted.
VIRUSTOTAL_API_KEY=
